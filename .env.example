BOT_TOKEN=replace-with-token-from-botfather
BOT_ADMIN_IDS=1608886567
BOT_SHARED_SECRET=generate-a-long-random-secret
BOT_DB_PATH=/app/bot.db
BOT_BIND_HOST=0.0.0.0
BOT_BIND_PORT=8081
BOT_BROADCAST_RATE=15
BOT_SCHEDULE_DIR=/app/schedules
BOT_BELLS_PATH=/app/assets/bells.png
# Optional read-only migration source from ripo_schedule_bot/users.db
BOT_LEGACY_DB_PATH=
# Optional role for legacy users without a selected role: applicant
BOT_LEGACY_DEFAULT_ROLE=

# Apply schema changes before starting the bot:
# docker compose run --rm bot python -m storage.migrate --db /app/bot.db
# (or run `python -m storage.migrate --db bot.db` from the project root)
# Optional one-time import of old users:
# python -m storage.migrate --db /app/bot.db --legacy-db /app/ripo-users.db
# Finished broadcast history is automatically deleted after this many days.
BOT_BROADCAST_RETENTION_DAYS=7
